# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only)
GEMINI_API_KEY=""

# GEMINI_MODEL: Model version to use for AI analysis and mentor (e.g. gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted
APP_URL=""

# DATABASE_URL: Database connection string (optional; SQLite storage enabled by default)
DATABASE_URL="file:./data/skillpath.db"

# AUTH_SECRET: Session token encryption key (server-side only)
AUTH_SECRET=""

# ADMIN_EMAIL & ADMIN_PASSWORD: Seed admin account credentials (server-side only)
ADMIN_EMAIL="premthakare986@gmail.com"
ADMIN_PASSWORD=""

# GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET: Optional GitHub OAuth integration (server-side only)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GITHUB_TOKEN: Optional GitHub personal access token to elevate public API rate limits (server-side only)
GITHUB_TOKEN=""

# YOUTUBE_API_KEY: Official Google YouTube Data API v3 key (server-side only)
YOUTUBE_API_KEY=""

# LINKEDIN_CLIENT_ID & LINKEDIN_CLIENT_SECRET: Optional LinkedIn OAuth integration (server-side only)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# FIREBASE AUTHENTICATION CONFIGURATION (Vite Client):
# Enable Firebase Authentication -> Sign-in method -> Google Provider in Firebase Console.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# VITE_API_BASE_URL: Base URL for API requests (Vite Client).
# Leave blank for same-origin deployment on Vercel (/api/*), or specify external backend URL if hosted separately.
VITE_API_BASE_URL=""
